# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=change-me

# Database (dev default falls back to SQLite file)
# SQLALCHEMY_DATABASE_URI=postgresql+psycopg://user:pass@host:5432/dbname

# Caching / Rate limits
# Use Redis in production; falls back to SimpleCache/memory for dev
# REDIS_URL=redis://localhost:6379/0
# RATELIMIT_STORAGE_URL=${REDIS_URL}
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=300
RATELIMIT_ENABLED=true

# Local performance toggles
PERF_ENABLED=true
ENABLE_METRICS=true

# Performance
PREWARM_ON_START=true
ANALYTICS_CACHE_TTL=120
FORECAST_CACHE_TTL=180
SLOW_REQUEST_MS=800

# Parquet
PARQUET_PATH=./cached_data.parquet

# Security headers
CSP_ENABLE=true
HSTS_ENABLE=true

# Scheduler
APP_ENABLE_SCHEDULER=true

# Observability (optional)
# Prometheus at /metrics enabled by default if package installed
# Sentry
# SENTRY_DSN=
# OpenTelemetry
# OTEL_ENABLE=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_SERVICE_NAME=customer-intel
